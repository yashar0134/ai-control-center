# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local SQLite database (never commit local data)
prisma/dev.db
prisma/dev.db-journal
prisma/dev.db-shm
prisma/dev.db-wal
*.sqlite
*.sqlite3

# local database backups made by "npm run app:update" (never commit local data)
prisma/backups/

# local runtime state written by "npm run app:start" (PID/port/log)
.local-run/

# local AI-tooling settings (never publish)
.claude/

# logs & OS/editor artifacts
logs/
*.log
Thumbs.db
Desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json

# test artifacts
/test-results/
/playwright-report/
