{
  "name": "ai-control-center",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first control center for monitoring AI subscriptions, API usage, costs, and coding-agent activity — truthful data provenance, no telemetry. Early-stage; current metrics are demo data.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yashar0134/ai-control-center.git"
  },
  "bugs": {
    "url": "https://github.com/yashar0134/ai-control-center/issues"
  },
  "homepage": "https://github.com/yashar0134/ai-control-center#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "npm@11.6.2",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:sync": "tsx prisma/sync-run.ts",
    "setup:local": "node scripts/local/setup.mjs",
    "app:start": "node scripts/local/start.mjs",
    "app:stop": "node scripts/local/stop.mjs",
    "app:status": "node scripts/local/status.mjs",
    "app:update": "node scripts/local/update.mjs",
    "validate": "npm run db:generate && npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "lucide-react": "^1.28.0",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
